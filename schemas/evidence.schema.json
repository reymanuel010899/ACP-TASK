{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://treessera.com/schemas/evidence.schema.json",
  "title": "Evidence",
  "description": "A machine-checkable artifact claim, broker-signed provider execution attestation, or both.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "capability_id"],
  "anyOf": [
    {
      "required": ["session_id", "schema_valid", "tests_passed", "artifact_hashes"]
    },
    {
      "required": ["execution_attestation"]
    }
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "description": "Unique identifier for this evidence bundle.",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "description": "session_id of the Session under which the work was performed.",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "description": "Capability.id of the capability that was exercised.",
      "minLength": 1
    },
    "schema_valid": {
      "type": "boolean",
      "description": "True iff the produced output validated against the capability's output_schema."
    },
    "tests_passed": {
      "type": "boolean",
      "description": "True iff the acceptance tests for the task passed."
    },
    "artifact_hashes": {
      "type": "object",
      "description": "Map of artifact filename to lowercase hex sha256 digest of its content. May be empty if the task produced no file artifacts, but the field itself is REQUIRED.",
      "additionalProperties": false,
      "patternProperties": {
        "^.+$": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "execution_attestation": {
      "type": "object",
      "description": "Opaque authoritative evidence signed by the credential broker after a provider action.",
      "additionalProperties": false,
      "required": [
        "attestation_id",
        "task_id",
        "user_principal_id",
        "agent_principal_id",
        "credential_id",
        "capability_id",
        "approved_payload_hash",
        "provider_receipt",
        "idempotency_key",
        "executed_at",
        "outcome",
        "broker_key_id",
        "material_hashes",
        "signature"
      ],
      "properties": {
        "attestation_id": {
          "type": "string",
          "pattern": "^attestation-[a-f0-9]{64}$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "user_principal_id": {
          "type": "string",
          "minLength": 1
        },
        "agent_principal_id": {
          "type": "string",
          "minLength": 1
        },
        "credential_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_payload_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider_receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "capability_id", "provider_id"],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "capability_id": {
              "type": "string",
              "minLength": 1
            },
            "provider_id": {
              "type": "string",
              "minLength": 1
            },
            "provider_account_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provider_timestamp": {
              "type": ["integer", "string"]
            }
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "executed_at": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "enum": ["succeeded", "failed"]
        },
        "broker_key_id": {
          "type": "string",
          "minLength": 1
        },
        "material_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "description": "RFC 3339 timestamp at which the evidence was produced.",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "description": "Open bag for vendor or profile extensions. Keys SHOULD be namespaced (e.g. 'vendor.example/field')."
    }
  }
}

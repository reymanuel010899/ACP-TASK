# Copy to .env and supply values locally. Never commit credentials or tokens.
APP_ENV=development

# Server-only service locations. The unprefixed names are used by the Next BFF.
CONCIERGE_URL=http://127.0.0.1:8130
SESSION_URL=http://127.0.0.1:8120
OAUTH_URL=http://127.0.0.1:8121
ACTION_BROKER_URL=http://127.0.0.1:8122
RUNNER_URL=http://127.0.0.1:8110
TESSERA_ACTION_BROKER_URL=http://127.0.0.1:8122
TESSERA_ACTION_BROKER_INTERNAL_TOKEN=

# Capability families and the account-wide emergency stop are NOT environment
# variables. They are durable per-tenant state an administrator changes from
# Integrations, effective immediately and without a restart, so two accounts on
# one process can hold different answers. Families land disabled; enabling one
# is a deliberate act.
TESSERA_DYNAMIC_PLANNER_SHADOW=true

# Local sandbox only: the tenant local tooling and the Phase 1 canary act in.
# It is no longer a fallback. A principal absent from
# TESSERA_PRINCIPAL_TENANTS_JSON is refused rather than landing here, because
# a contact directory behind that boundary would be handed to every principal
# nobody had mapped. To keep a regenerated browser identity working, map it:
# TESSERA_PRINCIPAL_TENANTS_JSON={"<principal-id>": "org:local"}
TESSERA_LOCAL_TENANT_ID=

# Add locally when enabling OAuth. Values intentionally omitted.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_APP_ID=
SLACK_OAUTH_REDIRECT_URI=https://localhost:3000/api/integrations/slack/callback

# One planning provider is recommended; RuleBrain remains the limited fallback.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Shared durable stores for local services
SESSION_DATABASE=tessera-sessions.db
OAUTH_DATABASE=tessera-oauth.db
WORKFLOW_DATABASE=tessera-workflows.db
ACTION_DATABASE=tessera-actions.db
# Public HTTPS origin Twilio can reach; never localhost in a live connection.
TWILIO_PUBLIC_CALLBACK_BASE=https://replace-with-your-tunnel.example
# HMAC secret used only for ACP-TASK callback correlation tokens.
TWILIO_CALLBACK_TOKEN_SECRET=replace-with-a-random-32-byte-secret
# Local-only tenant -> subaccount auth-token map used by the webhook process.
# Production resolves these from Vault instead of environment configuration.
TWILIO_WEBHOOK_AUTH_TOKENS_JSON={}
TWILIO_EVENT_DATABASE=tessera-twilio-events.db

# Phase 5 realtime voice. The bridge starts only when XAI_API_KEY is present.
# Use a dated model in approved voice definitions (never grok-voice-latest).
XAI_API_KEY=
VOICE_BRIDGE_TICKET_SECRET=replace-with-a-random-32-byte-secret
VOICE_TOOL_ENDPOINT=http://127.0.0.1:8122/internal/voice/tools
VOICE_TOOL_TOKEN=
VOICE_TRANSCRIPT_DATABASE=tessera-voice.db

# Manual Phase 6 canary only. Never point these at a production subaccount or
# an unverified destination. Real execution also requires --execute plus the
# exact spend-confirmation phrase documented in the runbook.
TWILIO_CANARY_ENABLED=false
TWILIO_CANARY_ACCOUNT_SID=
TWILIO_CANARY_DEDICATED_SUBACCOUNT_SID=
TWILIO_CANARY_AUTH_TOKEN=
TWILIO_CANARY_VERIFIED_DESTINATIONS_JSON={}
TWILIO_CANARY_STATUS_CALLBACK=
TWILIO_CANARY_SMS_FROM=
TWILIO_CANARY_WHATSAPP_FROM=
TWILIO_CANARY_WHATSAPP_SESSION_OPEN=false
TWILIO_CANARY_VOICE_FROM=
TWILIO_CANARY_TWIML_URL=
TWILIO_CANARY_PINNED_VOICE_MODEL=
